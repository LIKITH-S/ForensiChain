{
  "name": "blockchain-evidence-chain-of-custody",
  "version": "1.0.0",
  "private": true,
  "description": "Tamper-Evident Evidence Chain-of-Custody Smart Contract System",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "start:api": "node backend/server.js",
    "seed": "node scripts/seed.js",
    "demo:tamper": "node scripts/tamper-demo.js",
    "start:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "test:chaincode": "npm --prefix chaincode test",
    "start:full": "node scripts/start-full.js",
    "test:all": "node -e \"const {execSync}=require('child_process'); for(const cmd of ['npx hardhat test','npm --prefix chaincode test','npm --prefix frontend test','npm --prefix frontend run build']) execSync(cmd,{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^4.4.1",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.15"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "supertest": "^7.3.2"
  }
}
